# Optional: only used with --backend qwen. Full chat-completions URL.
QWEN_ENDPOINT=http://127.0.0.1:8000/v1/chat/completions
QWEN_MODEL=Qwen/Qwen3-8B
# Set QWEN_API_KEY securely in the process environment if required.
# .env files are not loaded automatically.

# vLLM launch (separate GPU host; optional local model weights)
QWEN_MODEL_PATH=Qwen/Qwen3-8B
QWEN_TENSOR_PARALLEL_SIZE=1
QWEN_MAX_MODEL_LEN=8192
# Supply VLLM_API_KEY and matching QWEN_API_KEY via secret management for remote use.
# Read-only kabu token obtained outside RADEN; do not commit a real value.
KABU_BASE_URL=http://127.0.0.1:18080/kabusapi
KABU_API_TOKEN=
